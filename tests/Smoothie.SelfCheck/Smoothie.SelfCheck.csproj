<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <!-- The plugin targets the game's Mono; the maths it checks has no Unity types. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Smoothie.SelfCheck</AssemblyName>
    <RootNamespace>Smoothie.SelfCheck</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/Smoothie/ThrottleMath.cs" />
  </ItemGroup>

  <!-- The native pyramid built for Linux, to check it against the C# one. -->
  <PropertyGroup>
    <NativeDir>$(MSBuildThisFileDirectory)../../src/SmoothieNative</NativeDir>
  </PropertyGroup>
  <Target Name="BuildNative" BeforeTargets="BeforeBuild" Inputs="$(NativeDir)/pyramid.c;$(NativeDir)/build.sh" Outputs="$(NativeDir)/bin/libSmoothieNative.so">
    <Exec Command="bash &quot;$(NativeDir)/build.sh&quot;" />
  </Target>
  <ItemGroup>
    <None Include="$(NativeDir)/bin/libSmoothieNative.so" Link="libSmoothieNative.so" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
