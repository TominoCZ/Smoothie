<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.1.1</Version>
    <AssemblyName>Smoothie</AssemblyName>
    <RootNamespace>Smoothie</RootNamespace>
  </PropertyGroup>

  <!-- Supplied by the running game: BepInEx 6, the interop assemblies it generates from the
       game's IL2CPP code, and SPT's patching helpers. -->
  <ItemGroup>
    <Reference Include="$(SptInterop)/*.dll" Private="false" />
    <Reference Include="BepInEx.Core"><HintPath>$(SptPath)/BepInEx/core/BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(SptPath)/BepInEx/core/BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.Common"><HintPath>$(SptPath)/BepInEx/core/BepInEx.Unity.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(SptPath)/BepInEx/core/Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(SptPath)/BepInEx/core/Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(SptPath)/BepInEx/core/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTushonka.Reflection"><HintPath>$(SptPath)/BepInEx/plugins/sptushonka/SPTushonka.Reflection.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTushonka.Common"><HintPath>$(SptPath)/BepInEx/plugins/sptushonka/SPTushonka.Common.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- The native depth pyramid and cell walk (src/SmoothieNative, needs mingw-w64), shipped next to the plugin. -->
  <PropertyGroup>
    <NativeDir>$(MSBuildThisFileDirectory)../SmoothieNative</NativeDir>
  </PropertyGroup>
  <Target Name="BuildNative" BeforeTargets="BeforeBuild" Inputs="$(NativeDir)/pyramid.c;$(NativeDir)/walk.c;$(NativeDir)/animpause.c;$(NativeDir)/lodflags.c;$(NativeDir)/build.sh" Outputs="$(NativeDir)/bin/SmoothieNative.dll">
    <Exec Command="bash &quot;$(NativeDir)/build.sh&quot;" />
  </Target>
  <ItemGroup>
    <None Include="$(NativeDir)/bin/SmoothieNative.dll" Link="SmoothieNative.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- dotnet build -p:SptDeploy=true  installs straight into the game. -->
  <Target Name="DeployToSpt" AfterTargets="Build" Condition="'$(SptDeploy)' == 'true'">
    <PropertyGroup>
      <SptPluginDir Condition="'$(SptPluginDir)' == ''">$(SptPath)/BepInEx/plugins/Smoothie</SptPluginDir>
    </PropertyGroup>
    <MakeDir Directories="$(SptPluginDir)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)SmoothieNative.dll" DestinationFolder="$(SptPluginDir)" />
    <Message Importance="high" Text="Smoothie -> $(SptPluginDir)" />
  </Target>

</Project>
