<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.5</Version>
    <AssemblyName>Smoothie</AssemblyName>
    <RootNamespace>Smoothie</RootNamespace>
  </PropertyGroup>

  <!-- Supplied by the running game. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(SptManaged)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(SptManaged)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(SptManaged)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(SptManaged)/UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AnimationSystem.Types"><HintPath>$(SptManaged)/AnimationSystem.Types.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(SptManaged)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(SptManaged)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(SptManaged)/UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(SptManaged)/UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(SptManaged)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.VideoModule"><HintPath>$(SptManaged)/UnityEngine.VideoModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TerrainModule"><HintPath>$(SptManaged)/UnityEngine.TerrainModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(SptManaged)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Comfort"><HintPath>$(SptManaged)/Comfort.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(SptPath)/BepInEx/core/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(SptPath)/BepInEx/core/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="spt-reflection"><HintPath>$(SptPath)/BepInEx/plugins/spt/spt-reflection.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- The native depth pyramid (src/SmoothieNative, needs mingw-w64), shipped next to the plugin. -->
  <PropertyGroup>
    <NativeDir>$(MSBuildThisFileDirectory)../SmoothieNative</NativeDir>
  </PropertyGroup>
  <Target Name="BuildNative" BeforeTargets="BeforeBuild" Inputs="$(NativeDir)/pyramid.c;$(NativeDir)/build.sh" Outputs="$(NativeDir)/bin/SmoothieNative.dll">
    <Exec Command="bash &quot;$(NativeDir)/build.sh&quot;" />
  </Target>
  <ItemGroup>
    <None Include="$(NativeDir)/bin/SmoothieNative.dll" Link="SmoothieNative.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- dotnet build -p:SptDeploy=true  installs straight into the game. -->
  <Target Name="DeployToSpt" AfterTargets="Build" Condition="'$(SptDeploy)' == 'true'">
    <PropertyGroup>
      <SptPluginDir Condition="'$(SptPluginDir)' == ''">$(SptPath)/BepInEx/plugins/Smoothie</SptPluginDir>
    </PropertyGroup>
    <MakeDir Directories="$(SptPluginDir)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)SmoothieNative.dll" DestinationFolder="$(SptPluginDir)" />
    <Message Importance="high" Text="Smoothie -> $(SptPluginDir)" />
  </Target>

</Project>
