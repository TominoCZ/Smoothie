<Project>
  <PropertyGroup>
    <!-- SPT 5.0 runs IL2CPP: BepInEx 6 loads plugins into its own .NET 10 runtime. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The SPT client folder holding EscapeFromTarkov.exe and BepInEx/. -->
  <PropertyGroup>
    <SptPath Condition="'$(SptPath)' == ''">$(SPT_PATH)</SptPath>
    <!-- Generated by BepInEx from the game on first start. -->
    <SptInterop>$(SptPath)/BepInEx/interop</SptInterop>
  </PropertyGroup>

  <Target Name="VerifySptPath" BeforeTargets="BeforeBuild">
    <Error Condition="'$(SptPath)' == ''"
           Text="SptPath is not set. Export SPT_PATH=/path/to/SPT or build with -p:SptPath=..." />
    <Error Condition="!Exists('$(SptInterop)/Assembly-CSharp.dll')"
           Text="Assembly-CSharp.dll not found under '$(SptInterop)'. Point SptPath at the SPT 5.0 client folder and start the game once, so BepInEx generates it." />
  </Target>
</Project>
